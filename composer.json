{
    "name": "godoi/lab-modern-php",
    "description": "Ambiente de desenvolvimento PHP moderno com Docker",
    "type": "project",
    "license": "MIT",
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpunit/phpunit": true
        }
    }
}
